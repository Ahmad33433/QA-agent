# Pick a provider: "openai" or "gemini" (Gemini has a free tier)
QA_LLM_PROVIDER=gemini

# Set the key for the provider you chose
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith tracing (only enabled when a key is set)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qa-agent

# Optional settings (defaults shown)
# QA_AGENT_MODEL=gemini-2.5-flash   (openai default: gpt-5-mini)
# QA_VISION_MODEL=gemini-2.5-flash  (openai default: gpt-4o)
# QA_HEADLESS=false
# QA_ARTIFACTS_DIR=./artifacts
# QA_HOST=127.0.0.1
# QA_PORT=8000
# QA_ALLOWED_ORIGINS=*
