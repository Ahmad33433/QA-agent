# Required
OPENAI_API_KEY=

# Optional: LangSmith tracing (only enabled when a key is set)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qa-agent

# Optional settings (defaults shown)
# QA_AGENT_MODEL=gpt-5-mini
# QA_VISION_MODEL=gpt-4o
# QA_HEADLESS=false
# QA_ARTIFACTS_DIR=./artifacts
# QA_HOST=127.0.0.1
# QA_PORT=8000
# QA_ALLOWED_ORIGINS=*
